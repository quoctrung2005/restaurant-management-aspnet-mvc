@model DA_LTW.Models.NHANVIEN

@{
    ViewBag.Title = "Thêm nhân viên";
    Layout = "~/Views/Shared/_LayoutDoAn.cshtml";
}

<h2>Thêm nhân viên</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        <div class="form-group">
            @Html.LabelFor(m => m.MaNV, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.MaNV, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.MaNV)
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.HoTen, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.HoTen)
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.VaiTro, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(m => m.VaiTro,
                    new SelectList(new[] {
                        "Thu ngân", "Phục vụ", "Bếp", "Thủ kho", "Quản lý"
                    }), "— Chọn vai trò —",
                    new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.VaiTro)
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Luong, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.Luong, new { @class = "form-control", type = "number" })
                @Html.ValidationMessageFor(m => m.Luong)
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Thêm" class="btn btn-primary" />
                @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary" })
            </div>
        </div>
    </div>
}
