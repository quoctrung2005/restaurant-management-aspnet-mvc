@model DA_LTW.Models.NHANVIEN

@{
    ViewBag.Title = "Chi tiết nhân viên";
    Layout = "~/Views/Shared/_LayoutDoAn.cshtml";
}

<h2>Chi tiết nhân viên</h2>

<div>
    <dl class="dl-horizontal">
        <dt>Mã nhân viên</dt>
        <dd>@Model.MaNV</dd>

        <dt>Họ tên</dt>
        <dd>@Model.HoTen</dd>

        <dt>Vai trò</dt>
        <dd>@Model.VaiTro</dd>

        <dt>Lương</dt>
        <dd>@String.Format("{0:N0} đ", Model.Luong)</dd>
    </dl>
</div>

<p>
    @Html.ActionLink("Sửa", "Edit", new { id = Model.MaNV }, new { @class = "btn btn-warning" })
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary" })
</p>
