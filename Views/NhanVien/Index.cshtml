@model IEnumerable<DA_LTW.Models.NHANVIEN>

@{
    ViewBag.Title = "Danh sách nhân viên";
    Layout = "~/Views/Shared/_LayoutDoAn.cshtml";
}

<h2>Danh sách nhân viên</h2>

<p>
    @Html.ActionLink("➕ Thêm nhân viên", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã NV</th>
            <th>Họ tên</th>
            <th>Vai trò</th>
            <th>Lương</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var nv in Model)
        {
            <tr>
                <td>@nv.MaNV</td>
                <td>@nv.HoTen</td>
                <td>@nv.VaiTro</td>
                <td>@String.Format("{0:N0} đ", nv.Luong)</td>
                <td>
                    @Html.ActionLink("Chi tiết", "Details", new { id = nv.MaNV }, new { @class = "btn btn-info btn-sm" })
                    @Html.ActionLink("Sửa", "Edit", new { id = nv.MaNV }, new { @class = "btn btn-warning btn-sm" })
                    @Html.ActionLink("Xóa", "Delete", new { id = nv.MaNV }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>

