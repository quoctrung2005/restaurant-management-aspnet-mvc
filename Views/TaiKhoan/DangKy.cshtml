@{
    ViewBag.Title = "DangKy";
    Layout = "~/Views/Shared/_LayoutTrangChu.cshtml";
}

<head><link rel="stylesheet" href="~/Content/css/css_form.css" /></head>

<div class="login-wrapper">
    <div class="login-box">

        <h2 class="title-login">Đăng Ký Tài Khoản</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center mb-4">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("XuLyDangKy", "TaiKhoan", FormMethod.Post))
        {
            <div class="form-group">
                <label class="form-label">Tên đăng nhập</label>
                <input type="text" name="username" class="form-control custom-input" placeholder="Nhập tên tài khoản" required />
            </div>

            <div class="form-group">
                <label class="form-label">Mật khẩu</label>
                <input type="password" name="password" class="form-control custom-input" placeholder="Nhập mật khẩu" required />
            </div>

            <div class="form-group">
                <label class="form-label">Nhập lại mật khẩu</label>
                <input type="password" name="repassword" class="form-control custom-input" placeholder="Xác nhận mật khẩu" required />
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary login-btn">
                    Đăng Ký
                </button>
            </div>

            <p class="text-center mt-4 mb-0 text-secondary">
                Bạn đã có tài khoản?
                <a href="/TaiKhoan/DangNhap" class="register-link">Đăng nhập ngay</a>
            </p>
        }
    </div>
</div>

